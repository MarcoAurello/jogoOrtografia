# Copie para api/.env (desenvolvimento) ou cadastre no Dokploy (produção).
PORT=3333
DB_HOST=localhost
DB_PORT=3306
DB_NAME=games
DB_USER=root
DB_PASSWORD=troque-esta-senha

# segredo do login (JWT): uma frase longa e aleatória
JWT_SECRET=troque-por-uma-frase-longa-e-aleatoria
JWT_EXPIRES_IN=12h

# primeiro administrador da plataforma (criado pelo seeder, só se ainda não existir)
ADMIN_EMAIL=admin@pedagogiagamificada.com.br
ADMIN_SENHA=troque-esta-senha

# planilha do Google (até a fase 4): o endereço da planilha principal e a SENHA_PROFESSOR dos scripts.
# A senha fica só aqui no servidor; o app não sabe mais dela.
URL_PLANILHA=https://script.google.com/macros/s/AKfycbzfaBB9wEG3wlP7PKRymBNOfvovZxViQ08vuC0IzTBZS63iYjqQW2GBskUEqM0DHj3i/exec
SENHA_PLANILHA=app0707

# onde está o index.html do app (para a página de cada escola já sair com a marca dela)
ARQUIVO_INDEX=../index.html
