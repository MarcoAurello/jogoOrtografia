# Copie para .env (docker compose no computador) ou cadastre no Dokploy (Environment do compose).
DB_NAME=games
DB_PASSWORD=troque-esta-senha

# segredo do login (JWT): uma frase longa e aleatória
JWT_SECRET=troque-por-uma-frase-longa-e-aleatoria

# primeiro administrador da plataforma (criado na primeira subida, se ainda não existir)
ADMIN_EMAIL=admin@pedagogiagamificada.com.br
ADMIN_SENHA=troque-esta-senha

# planilha do Google (até a fase 4): endereço da planilha principal e a SENHA_PROFESSOR dos scripts
URL_PLANILHA=https://script.google.com/macros/s/AKfycbzfaBB9wEG3wlP7PKRymBNOfvovZxViQ08vuC0IzTBZS63iYjqQW2GBskUEqM0DHj3i/exec
SENHA_PLANILHA=app0707
# a SENHA_ADMIN do script (só para importar as escolas da planilha para o banco)
SENHA_ADMIN_PLANILHA=app1234

# como saem os e-mails (o relatório de cada partida para o professor e o PDF do teste grátis):
# - smtp (recomendado): a própria API envia, sem a planilha do Google. Preencha as linhas SMTP_ abaixo
#   (Resend, e-mail da Hostinger, Gmail com senha de app...). No computador, use a caixa de teste:
#   SMTP_HOST=mailpit e SMTP_PORT=1025 (veja docs/COMO-RODAR-EM-OUTRA-MAQUINA.md).
# - planilha: o Apps Script da planilha envia pelo Gmail da conta dela (o "carteiro"; precisa do script versão 6).
EMAIL_VIA=planilha
# SMTP (só com EMAIL_VIA=smtp). Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_SEGURO=true, SMTP_USER=resend,
#   SMTP_PASS=a chave da API do Resend (o domínio do remetente precisa estar verificado no Resend).
# Exemplo com o e-mail da Hostinger:
#   SMTP_HOST=smtp.hostinger.com  SMTP_PORT=465  SMTP_SEGURO=true  SMTP_USER=contato@seudominio  SMTP_PASS=senha-do-email
# Gmail: SMTP_HOST=smtp.gmail.com, porta 587, e uma "senha de app" da conta Google.
SMTP_HOST=
SMTP_PORT=587
SMTP_SEGURO=false
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE=Pedagogia Gamificada <nao-responda@pedagociagamificada.com.br>

# endereço do app (CORS) e porta no computador
FRONTEND_URL=https://pedagociagamificada.com.br
PORTA_WEB=8089

# questões por IA (Questionários → "Gerar com IA"): fotos ou PDF de exercício viram perguntas para o professor revisar.
# Plano GRATUITO: basta uma das chaves (as duas = o Groq vira reserva quando o Google falhar). Sem chave, o botão avisa.
# - GEMINI_API_KEY: https://aistudio.google.com/apikey  (lê foto e PDF; no plano grátis o Google pode usar o conteúdo)
# - GROQ_API_KEY:   https://console.groq.com/keys       (reserva: PDF pelo texto; foto só se a conta tiver modelo de visão)
GEMINI_API_KEY=
GROQ_API_KEY=
# opcionais: modelos (trocam sozinhos se o atual for aposentado), qual vem primeiro e gerações por pessoa por dia
GEMINI_MODELO=gemini-3.5-flash
GROQ_MODELO=openai/gpt-oss-120b
GROQ_MODELO_VISAO=qwen/qwen3.8-27b
IA_PRINCIPAL=gemini
IA_LIMITE_DIARIO=20
# só para o teste automático no computador (perguntas fixas, sem chamar a IA). Nunca ligue na produção.
IA_FALSA=0

# licença dos jogos: só o site oficial recebe o passe (js/licenca.js). Chave privada ECDSA P-256 em PEM, em base64.
# Gerar: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt | base64 -w0
# (a chave pública correspondente vai em CHAVE_PUBLICA no js/licenca.js). Vazio = licença desligada.
LICENCA_CHAVE_PRIVADA=
LICENCA_DIAS=3
